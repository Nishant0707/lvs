{
  "name": "lvs-live-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "predev": "npm run build:demo",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run build:demo",
    "build:demo": "esbuild demo/app.ts demo/call.ts --bundle --minify --outdir=public",
    "start": "node dist/server.js",
    "lint": "eslint src tests demo",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "test:realtime": "node scripts/realtime.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "format": "prettier --write src tests demo public/*.html public/*.css docs README.md *.json *.yml deploy .github scripts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jose": "^6.1.0",
    "mongoose": "^8.19.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "happy-dom": "^20.14.5",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.8",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}